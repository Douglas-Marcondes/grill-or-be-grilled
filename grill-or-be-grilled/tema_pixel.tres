[resource]
default_font = ExtResource("1_fonte")
default_font_size = 12
Button/colors/font_color = Color(0.933333, 0.764706, 0.603922, 1)
Button/colors/font_hover_color = Color(0.984314, 0.949020, 0.211765, 1)
Button/colors/font_pressed_color = Color(1, 1, 1, 1)
Button/colors/font_disabled_color = Color(0.517647, 0.494118, 0.529412, 1)
Button/styles/normal = SubResource("botao_normal")
Button/styles/hover = SubResource("botao_realce")
Button/styles/pressed = SubResource("botao_apertado")
Button/styles/focus = SubResource("botao_realce")
Button/styles/disabled = SubResource("botao_normal")
Label/colors/font_color = Color(0.796078, 0.858824, 0.988235, 1)
ProgressBar/styles/background = SubResource("barra_fundo")
ProgressBar/styles/fill = SubResource("barra_preenchida")
