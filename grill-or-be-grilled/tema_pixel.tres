[gd_resource type="Theme" load_steps=7 format=3]
; Tema unico da interface. Centraliza fonte, cores e bordas para que a UI nao
; precise de add_theme_*_override espalhado pelo codigo. Todas as cores saem da
; paleta DawnBringer 32 usada pela arte (tools/arte/paleta.py).

[ext_resource type="FontFile" path="res://Artes/gerado/fonte_pixel.fnt" id="1_fonte"]

[sub_resource type="StyleBoxFlat" id="botao_normal"]
bg_color = Color(0.133333, 0.125490, 0.203922, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.270588, 0.156863, 0.235294, 1)
content_margin_left = 5.0
content_margin_top = 3.0
content_margin_right = 5.0
content_margin_bottom = 3.0
anti_aliasing = false

[sub_resource type="StyleBoxFlat" id="botao_realce"]
